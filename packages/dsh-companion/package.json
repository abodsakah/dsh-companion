{
  "name": "dsh-companion",
  "version": "0.1.0",
  "description": "DeepSeek Harness companion plugin: a general notification bus that pushes questions, approvals, and turn events to the companion mobile app over Expo push, and holds unanswered requests until the phone answers.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/schemastery": ">=3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@dsh-companion/protocol": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
